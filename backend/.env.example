# Copie para .env e carregue com:  uvicorn app.main:app --env-file .env  (requer python-dotenv)
# ou exporte as variáveis no terminal.

# dev | prod  (fora de dev, JWT_SEGREDO e CHAVE_DADOS são obrigatórios)
COUPLEHUB_AMBIENTE=dev

# padrão: sqlite:///backend/data/couplehub.db
# COUPLEHUB_DATABASE_URL=sqlite:///./data/couplehub.db

# segredo do JWT (32+ caracteres):  python -c "import secrets; print(secrets.token_urlsafe(48))"
# COUPLEHUB_JWT_SEGREDO=

# chave Fernet das respostas cifradas:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# em dev, se vazia, é gerada em backend/data/.chave_dev
# COUPLEHUB_CHAVE_DADOS=

# validade do token em minutos (padrão: 7 dias)
# COUPLEHUB_JWT_EXPIRACAO_MIN=10080

# origens CORS separadas por vírgula (o app nativo não precisa; útil para Expo Web)
# COUPLEHUB_CORS=*

# SÓ EM DEV: a API "vive" N dias no futuro (testar fechamento de semana, créditos e prazos)
# COUPLEHUB_AVANCAR_DIAS=7
